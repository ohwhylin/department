@using DepartmentContracts.ViewModels

@{
    ViewData["Title"] = "Сведения об успеваемости";

    var records = ViewBag.DisciplineStudentRecordsList as List<DisciplineStudentRecordViewModel> ?? new List<DisciplineStudentRecordViewModel>();
    var disciplines = ViewBag.DisciplinesList as List<DisciplineViewModel> ?? new List<DisciplineViewModel>();
    var students = ViewBag.StudentsList as List<StudentViewModel> ?? new List<StudentViewModel>();
}

<div class="list-shell">
    <div class="list-head">
        <div>
            <h2 class="list-title">Список записей успеваемости</h2>
            <div class="list-sub">
                Управление записями успеваемости студентов.
            </div>
        </div>
        <div class="d-flex gap-2">
            <form asp-controller="DisciplineStudentRecords" asp-action="Sync" method="post" class="d-inline">
                <button type="submit" class="btn btn-app-primary">Синхронизировать данные</button>
            </form>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success m-3">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger m-3">
            @TempData["Error"]
        </div>
    }

    @if (records.Count > 0)
    {
        @foreach (var item in records)
        {
            var discipline = disciplines.FirstOrDefault(x => x.Id == item.DisciplineId);
            var student = students.FirstOrDefault(x => x.Id == item.StudentId);

            <div class="entity-row">
                <div class="entity-accent"></div>
                <div class="entity-content">
                    <div class="entity-main">
                        <h5 class="entity-title">Запись №@item.Id</h5>
                        <div class="entity-meta">
                            <span class="meta-chip">Дисциплина: @discipline?.DisciplineName</span>
                            <span class="meta-chip">Студент: @student?.LastName @student?.FirstName</span>
                            <span class="meta-chip">Семестр: @item.Semester</span>
                            <span class="meta-chip">Вариант: @item.Variant</span>
                            <span class="meta-chip">Подгруппа: @item.SubGroup</span>
                        </div>
                    </div>
                </div>
                <div class="entity-actions">
                    <div class="actions-stack">
                        <a class="btn btn-sm btn-app-outline" asp-controller="DisciplineStudentRecords" asp-action="Details" asp-route-id="@item.Id">Подробнее</a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-secondary m-3">
            Данные отсутствуют. Выполните синхронизацию.
        </div>
    }
</div>