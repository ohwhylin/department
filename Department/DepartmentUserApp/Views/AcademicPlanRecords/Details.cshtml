@model DepartmentContracts.ViewModels.AcademicPlanRecordViewModel
@using DepartmentDataModels.Enums
@{
    ViewData["Title"] = "Подробнее о AcademicPlanRecord";
}

<div class="app-card">
    <div class="app-card-header">
        <h2 class="app-card-title">Подробнее о AcademicPlanRecord</h2>
        <div class="d-flex gap-2">
            <a class="btn btn-sm btn-light" asp-controller="AcademicPlanRecords" asp-action="Update" asp-route-id="@Model.Id">Изменить</a>
            <a class="btn btn-sm btn-light" asp-controller="AcademicPlanRecords" asp-action="List">К списку</a>
        </div>
    </div>
    <div class="p-3">
        <dl class="row mb-0">
            <dt class="col-sm-4 text-muted">
                Id
            </dt>
            <dd class="col-sm-8">
                @Model.Id
            </dd>
            <dt class="col-sm-4 text-muted">
                AcademicPlan
            </dt>
            <dd class="col-sm-8">
                @Model.AcademicPlan
            </dd>
            <dt class="col-sm-4 text-muted">
                Индекс
            </dt>
            <dd class="col-sm-8">
                @Model.Index
            </dd>
            <dt class="col-sm-4 text-muted">
                Название
            </dt>
            <dd class="col-sm-8">
                @Model.Name
            </dd>
            <dt class="col-sm-4 text-muted">
                Семестр
            </dt>
            <dd class="col-sm-8">
                @Model.Semester
            </dd>
            <dt class="col-sm-4 text-muted">
                ZET
            </dt>
            <dd class="col-sm-8">
                @Model.Zet
            </dd>
            <dt class="col-sm-4 text-muted">
                Академические часы
            </dt>
            <dd class="col-sm-8">
                @Model.AcademicHours
            </dd>
            <dt class="col-sm-4 text-muted">
                Экзамен
            </dt>
            <dd class="col-sm-8">
                @Model.Exam
            </dd>
            <dt class="col-sm-4 text-muted">
                Зачет
            </dt>
            <dd class="col-sm-8">
                @Model.Pass
            </dd>
            <dt class="col-sm-4 text-muted">
                Дифференцированный зачет
            </dt>
            <dd class="col-sm-8">
                @Model.GradedPass
            </dd>
            <dt class="col-sm-4 text-muted">
                Курсовая работа
            </dt>
            <dd class="col-sm-8">
                @Model.CourseWork
            </dd>
            <dt class="col-sm-4 text-muted">
                Курсовой проект
            </dt>
            <dd class="col-sm-8">
                @Model.CourseProject
            </dd>
            <dt class="col-sm-4 text-muted">
                РГР
            </dt>
            <dd class="col-sm-8">
                @Model.Rgr
            </dd>
            <dt class="col-sm-4 text-muted">
                Лекции
            </dt>
            <dd class="col-sm-8">
                @Model.Lectures
            </dd>
            <dt class="col-sm-4 text-muted">
                Лабораторные часы
            </dt>
            <dd class="col-sm-8">
                @Model.LaboratoryHours
            </dd>
            <dt class="col-sm-4 text-muted">
                Практические часы
            </dt>
            <dd class="col-sm-8">
                @Model.PracticalHours
            </dd>
        </dl>
    </div>
</div>