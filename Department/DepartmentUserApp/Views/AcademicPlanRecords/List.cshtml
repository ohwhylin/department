@{
    ViewData["Title"] = "AcademicPlanRecords";
}

<div class="list-shell">
    <div class="list-head">
        <div>
            <h2 class="list-title">Список записей учебных планов</h2>
        </div>
        <div class="d-flex gap-2">
            <form asp-controller="AcademicPlans" asp-action="Sync" method="post" class="d-inline">
                <button type="submit" class="btn btn-app-primary">Синхронизировать данные</button>
            </form>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mt-3">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mt-3">
            @TempData["Error"]
        </div>
    }

    @if (ViewBag.AcademicPlanRecordsList != null && ViewBag.AcademicPlanRecordsList.Count > 0)
    {
        @foreach (var item in ViewBag.AcademicPlanRecordsList)
        {
            <div class="entity-row">
                <div class="entity-accent"></div>
                <div class="entity-content">
                    <div class="entity-main">
                        <h5 class="entity-title">Запись учебного плана №@item.Id</h5>
                        <div class="entity-meta">
                            <span class="meta-chip">Id: @item.Id</span>
                            <span class="meta-chip">@item.AcademicPlan</span>
                            <span class="meta-chip">@item.Discipline</span>
                            <span class="meta-chip">@item.Semester</span>
                            <span class="meta-chip">ZET: @item.Zet</span>
                        </div>
                    </div>
                </div>
                <div class="entity-actions">
                    <div class="actions-stack">
                        <a class="btn btn-sm btn-app-outline"
                   asp-controller="AcademicPlanRecords"
                   asp-action="Details"
                   asp-route-id="@item.Id">
                            Подробнее
                        </a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-secondary mt-3">
            Данные отсутствуют. Выполните синхронизацию.
        </div>
    }
</div>